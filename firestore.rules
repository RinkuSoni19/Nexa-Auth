rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'name',
        'email',
        'avatar',
        'authMethod',
        'plan',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'name',
        'email',
        'avatar',
        'authMethod',
        'plan',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && data.uid == userId
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
      && data.avatar is string && data.avatar.size() <= 2048
      && data.authMethod is string && data.authMethod == 'google'
      && data.plan is string && data.plan in ['free', 'trial-7d', '3-months', '1-year', 'pro', 'enterprise']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      // Strictly isolate PII to the authenticated owner; forbid collection listing.
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId;

      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().authMethod == existing().authMethod
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Sync Google profile or update display name / avatar / plan
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'avatar', 'plan', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId;
    }
  }
}
